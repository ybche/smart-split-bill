{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/categories", "destination": "/api/categories/route" },
    { "source": "/api/categories/:slug*", "destination": "/api/categories/route" },
    { "source": "/api/transactions", "destination": "/api/transactions/route" },
    { "source": "/api/transactions/:slug*", "destination": "/api/transactions/route" },
    { "source": "/api/participants", "destination": "/api/participants/route" },
    { "source": "/api/participants/:slug*", "destination": "/api/participants/route" },
    { "source": "/api/payments", "destination": "/api/payments/route" },
    { "source": "/api/payments/:slug*", "destination": "/api/payments/route" },
    { "source": "/api/payment-methods", "destination": "/api/payment-methods/route" },
    { "source": "/api/payment-methods/:slug*", "destination": "/api/payment-methods/route" },
    { "source": "/api/admins", "destination": "/api/admins/route" },
    { "source": "/api/admins/:slug*", "destination": "/api/admins/route" },
    { "source": "/api/auth", "destination": "/api/auth/route" },
    { "source": "/api/auth/:slug*", "destination": "/api/auth/route" },
    { "source": "/api/db", "destination": "/api/db/route" },
    { "source": "/api/db/:slug*", "destination": "/api/db/route" },
    { "source": "/api/public", "destination": "/api/public/route" },
    { "source": "/api/public/:slug*", "destination": "/api/public/route" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
