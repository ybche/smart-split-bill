{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/categories", "destination": "/api/categories/_handler" },
    { "source": "/api/categories/:slug*", "destination": "/api/categories/_handler" },
    { "source": "/api/transactions", "destination": "/api/transactions/_handler" },
    { "source": "/api/transactions/:slug*", "destination": "/api/transactions/_handler" },
    { "source": "/api/participants", "destination": "/api/participants/_handler" },
    { "source": "/api/participants/:slug*", "destination": "/api/participants/_handler" },
    { "source": "/api/payments", "destination": "/api/payments/_handler" },
    { "source": "/api/payments/:slug*", "destination": "/api/payments/_handler" },
    { "source": "/api/payment-methods", "destination": "/api/payment-methods/_handler" },
    { "source": "/api/payment-methods/:slug*", "destination": "/api/payment-methods/_handler" },
    { "source": "/api/admins", "destination": "/api/admins/_handler" },
    { "source": "/api/admins/:slug*", "destination": "/api/admins/_handler" },
    { "source": "/api/auth", "destination": "/api/auth/_handler" },
    { "source": "/api/auth/:slug*", "destination": "/api/auth/_handler" },
    { "source": "/api/db", "destination": "/api/db/_handler" },
    { "source": "/api/db/:slug*", "destination": "/api/db/_handler" },
    { "source": "/api/public", "destination": "/api/public/_handler" },
    { "source": "/api/public/:slug*", "destination": "/api/public/_handler" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
